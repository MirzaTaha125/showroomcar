PORT=5000
MONGODB_URI=mongodb://localhost:27017/showroom
# Optional. Only needed for mongodb+srv:// URIs when Node cannot resolve SRV records
# ("querySrv ECONNREFUSED"). Comma-separated resolvers, e.g. 8.8.8.8,1.1.1.1
# DNS_SERVERS=
JWT_SECRET=CHANGE_THIS_TO_A_SECURE_RANDOM_STRING_IN_PRODUCTION
JWT_EXPIRE=7d
FRONTEND_URL=http://localhost:3000
NODE_ENV=development
